{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solvestack",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/key.php",
      "/",
      "/incident-report-template/",
      "/incident-report-template/*",
      "/5-whys-template/",
      "/5-whys-template/*",
      "/fishbone-diagram-template/",
      "/fishbone-diagram-template/*",
      "/rca-template/",
      "/rca-template/*",
      "/use-your-data/",
      "/use-your-data/*",
      "/onenote-vs-solvestack/",
      "/onenote-vs-solvestack/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
