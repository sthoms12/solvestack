{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solvestack",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Exact `/path/` entries are redundant with `/path/*` under current
    // wrangler validation and fail Workers Builds deploy.
    "run_worker_first": [
      "/key.php",
      "/",
      "/incident-report-template/*",
      "/5-whys-template/*",
      "/fishbone-diagram-template/*",
      "/rca-template/*",
      "/use-your-data/*",
      "/onenote-vs-solvestack/*",
      "/agent-adapter/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
